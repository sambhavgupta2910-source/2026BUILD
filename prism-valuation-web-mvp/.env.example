# Required for Claude AI market commentary
ANTHROPIC_API_KEY=sk-ant-...

# Data source (pick one):
# Option A — local CSV file (fastest, no network)
# TRANSACTIONS_CSV=/absolute/path/to/transactions.csv

# Option B — custom URL (fetched once on boot, cached to .cache/)
# TRANSACTIONS_URL=https://your-host.com/transactions.csv

# Option C — leave both unset to use the built-in Google Drive default
# The Drive file must be shared as "anyone with the link"

# Force cache refresh on next boot:
# PRISM_REFRESH=1

# Manual refresh webhook secret — POST /api/refresh?token=<value>
# Set any random string; leave unset to disable the endpoint
# REFRESH_SECRET=change-me-to-a-random-secret

# Server port (Railway sets this automatically):
# PORT=4173
