# Required for Claude AI market commentary
ANTHROPIC_API_KEY=sk-ant-...

# ── Data source (pick one, highest priority first) ───────────────────────────

# Option A — Dubai Pulse CKAN API (live daily data, recommended once registered)
# DUBAI_PULSE_API_URL=https://dubaipulse.gov.ae/api/3/action/datastore_search?resource_id=<id>&limit=1000000
# DUBAI_PULSE_API_KEY=<your-api-key>

# Option B — local CSV file (fastest, for development)
# TRANSACTIONS_CSV=/absolute/path/to/transactions.csv

# Option C — CSV URL (Google Drive or any public URL; cached to .cache/ on first fetch)
# TRANSACTIONS_URL=https://drive.google.com/uc?export=download&id=<file-id>
# Leave unset to use the built-in Drive default (must be shared as "anyone with the link")

# Force cache re-fetch on next boot (Option C only):
# PRISM_REFRESH=1

# ── Refresh webhook ──────────────────────────────────────────────────────────

# Secures POST /api/refresh?token=<value> — set any random string; leave unset to disable
# REFRESH_SECRET=change-me-to-a-random-secret

# ── GitHub Actions pipeline (set as GitHub repository secrets) ───────────────
# DUBAI_PULSE_API_URL       — same as above
# DUBAI_PULSE_API_KEY       — same as above
# GOOGLE_SERVICE_ACCOUNT_JSON — base64-encoded GCP service account JSON (drive.file scope)
# DRIVE_FILE_ID             — Drive file ID to overwrite each night
# PRISM_URL                 — Railway deployment URL e.g. https://prism.railway.app
# REFRESH_SECRET            — same value as the Railway env var above

# ── Server ───────────────────────────────────────────────────────────────────
# PORT=4173  (Railway sets this automatically)
