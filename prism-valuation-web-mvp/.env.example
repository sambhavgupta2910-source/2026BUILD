# ── AI Market Commentary + Deal Engine (Grok / xAI) ──────────────────────────
# Sign up free at console.x.ai — $25 free credits on first account
# Model used: grok-3-mini (fast, cheap, excellent for data commentary)
# Powers: /api/analysis, /api/deal-check, /api/content-draft
XAI_API_KEY=xai-...

# ── Cinematic Video Generation (Higgsfield AI) ────────────────────────────────
# Get API key from cloud.higgsfield.ai/api-keys — $15/mo Starter = ~20 clips
# Powers: /api/content-draft (video_job_id) + /api/video-status polling
# HIGGSFIELD_API_KEY=hf-...

# ── Lead Notifications ────────────────────────────────────────────────────────
# Your WhatsApp Business number (digits only, country code first, no + or spaces)
# e.g. 971501234567 for +971 50 123 4567
AGENT_WHATSAPP=971501234567

# ── Data source (pick one, highest priority first) ───────────────────────────

# Option A — Dubai Pulse CKAN API (live daily data, recommended once registered)
# DUBAI_PULSE_API_URL=https://dubaipulse.gov.ae/api/3/action/datastore_search?resource_id=<id>&limit=1000000
# DUBAI_PULSE_API_KEY=<your-api-key>

# Option B — local CSV file (fastest, for development)
# TRANSACTIONS_CSV=/absolute/path/to/transactions.csv

# Option C — CSV URL (Google Drive or any public URL; cached to .cache/ on first fetch)
# TRANSACTIONS_URL=https://drive.google.com/uc?export=download&id=<file-id>
# Leave unset to use the built-in Drive default (must be shared as "anyone with the link")

# ── Digital Dubai (data.dubai / DDADS) API → live DLD data ────────────────────
# Official DDA gateway. scripts/fetch-ddads.js mints a token, can `sample` an
# endpoint, and `pull`s DLD transactions into PRISM's canonical CSV
# (transactions-dld.csv), which `npm run start:dld` then serves.
# STG and PROD are separate environments with SEPARATE credential sets — each
# arrives in its own DDA onboarding email, and creds from one environment get
# 403 on the other. NEVER commit real values.
# Geofenced to the UAE in BOTH environments — calls only work from inside the UAE.
# DATA_DUBAI_BASE_URL=https://apis.data.dubai         # staging: https://stg-apis.data.dubai
# DATA_DUBAI_SECURITY_IDENTIFIER=<x-DDA-SecurityApplicationIdentifier from that env's email>
# DATA_DUBAI_CLIENT_ID=<client_id from that env's email>
# DATA_DUBAI_CLIENT_SECRET=<client_secret from that env's email>
# DATA_DUBAI_ENDPOINT=/open/dld/dld_transactions-open-api

# ── Refresh webhook ───────────────────────────────────────────────────────────
# Secures POST /api/refresh?token=<value> — set any random string
# REFRESH_SECRET=change-me-to-a-random-secret

# ── Agent CRM ─────────────────────────────────────────────────────────────────
# If set, /crm and /api/crm/* require ?token=<value>. Leave unset for open
# access on a local/dev machine. Leads are stored in .data/leads.json (gitignored).
# CRM_TOKEN=change-me-to-a-random-secret

# ── GitHub Actions pipeline (set as GitHub repository secrets) ────────────────
# DUBAI_PULSE_API_URL, DUBAI_PULSE_API_KEY, GOOGLE_SERVICE_ACCOUNT_JSON,
# DRIVE_FILE_ID, PRISM_URL, REFRESH_SECRET

# ── Server ────────────────────────────────────────────────────────────────────
# PORT=4173  (Railway sets this automatically)
